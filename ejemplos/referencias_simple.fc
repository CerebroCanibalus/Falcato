// Ejemplo de referencias y borrowing

función principal() -> Entero32 {
    el x: Entero32 = 42;
    
    // Referencia inmutable
    la ref: &Entero32 = &x;
    
    // Referencia mutable
    el ref_mut: &mut Entero32 = &mut x;
    
    // Dereferencia (cargar valor desde puntero)
    el valor: Entero32 = *ref;
    
    retornar valor;
}
