// Ejemplo de arrays en Falcato
// Arrays se declaran con artículo plural 'los'

función principal() -> Entero32 {
    // Array de 5 elementos, inicializado con "todos"
    los nums: [Entero32; 5] = todos 0;
    
    // Asignar valores
    nums[0] = 10;
    nums[1] = 20;
    nums[2] = 30;
    
    // Sumar elementos
    el suma: Entero32 = nums[0] + nums[1] + nums[2];
    
    retornar suma;
}
