el función vector_longitud<T>(v: Vector<T>) -> Entero32 {
    retornar vector_longitud(v); // builtin
}

el función vector_esta_vacio<T>(v: Vector<T>) -> Booleano {
    retornar vector_longitud(v) == 0;
}

